{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "rpg-roguelite-game",
  "version": "0.1.0",
  "identifier": "com.kkphoenix.rpgroguelite",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npx vite build"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "rpg-roguelite-game",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "devtools": true,
        "windowClassname": "com.kkphoenix.rpgroguelite"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "dmg"],
    "externalBin": ["bin/ollama", "bin/panteao-engine"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.icns"
    ]
  }
}
